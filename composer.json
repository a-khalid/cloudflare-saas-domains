{
    "name": "a-khalid/cloudflare-saas-domains",
    "description": "Manage the full lifecycle of tenant custom domains on Cloudflare for SaaS (Custom Hostnames) in Laravel.",
    "keywords": ["laravel", "cloudflare", "cloudflare-for-saas", "custom-hostnames", "multi-tenant", "ssl-for-saas"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "laravel/framework": "^10.48|^11.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.34|^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.2|^4.1",
        "stancl/tenancy": "^3.9"
    },
    "suggest": {
        "stancl/tenancy": "Initializes tenancy automatically when a tenant is resolved by hostname."
    },
    "autoload": {
        "psr-4": {
            "AKhalid\\CloudflareSaasDomains\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AKhalid\\CloudflareSaasDomains\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AKhalid\\CloudflareSaasDomains\\CloudflareSaasDomainsServiceProvider"
            ],
            "aliases": {
                "CloudflareSaasDomains": "AKhalid\\CloudflareSaasDomains\\Facades\\CloudflareSaasDomains"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
