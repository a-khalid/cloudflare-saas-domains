includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        - database
    tmpDir: .phpunit.cache/phpstan
    ignoreErrors:
        # A public trait for host applications: nothing in the package uses it.
        - identifier: trait.unused
          path: src/Concerns/HasCustomDomains.php
